# Same Neon connection string as packages/db/.env
DATABASE_URL=postgres://user:password@host.neon.tech/dbname?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000


# Inngest — local dev works without these (use npx inngest-cli@latest dev)
# For production: get from app.inngest.com → your app → Manage → Signing Key
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# OpenAI API key — get one at platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: override default model IDs
# AI_MODEL_TRIAGE=gpt-4o
# AI_MODEL_PRD=gpt-4o
# AI_MODEL_TASKS=gpt-4o
# AI_MODEL_CODEGEN=gpt-4o

# Google OAuth (OIDC) — console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: ${BETTER_AUTH_URL}/api/auth/callback/google
# (e.g. http://localhost:3000/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
INNGEST_DEV=1


# GitHub App (Phase 3) — register at github.com/settings/apps/new.
# Set the App's "Setup URL" to ${BETTER_AUTH_URL}/api/github/callback and the
# webhook URL to ${BETTER_AUTH_URL}/api/github/webhooks. The private key is the
# downloaded .pem; paste it on one line with literal \n between lines (the app
# un-escapes them). Never commit it.
# Without these the GitHub section just shows "not configured" — app still boots.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# Razorpay (Phase 6 billing) — dashboard.razorpay.com → Settings → API Keys for
# the Key ID/Secret. Add a webhook at ${BETTER_AUTH_URL}/api/razorpay/webhook,
# subscribe it to the "order.paid" (and "payment.captured") events, and put the
# webhook's signing secret in RAZORPAY_WEBHOOK_SECRET. Without these, billing
# shows "not configured", checkout is disabled, and every workspace stays Free —
# the app still boots. Never commit real keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Resend — sends workspace invitation emails. Get a key at resend.com/api-keys.
# Without a key, invites still work (the accept link is shown in Settings to
# copy/share); with a key, invitees are emailed automatically.
RESEND_API_KEY=your_resend_api_key_here

# From address for invitation emails. Defaults to Resend's shared test sender
# (onboarding@resend.dev), which can ONLY deliver to your own Resend account
# INVITE_FROM_EMAIL=Throughline <invites@through.online>